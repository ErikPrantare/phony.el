(require 'cl-lib)
(require 'subr-x)
(require 'map)
(require 'server)
(require 'multisession)

(require 'phony-element)
(require 'simulacrum)

(defgroup phony nil
  "Functionality for defining speech bindings."
  :group 'files)

(defcustom phony-output-directory (locate-user-emacs-file "phony")
  "Directory for files generated by phony."
  :type 'directory
  :group 'phony)

(defcustom phony-ast-evaluation-function #'phony-generate-event
  "Function used to evaluate ASTs generated by phony.
Anytime a command is executed, this function is invoked with an AST
representing the recognized utterance."
  :type 'function
  :group 'phony)

(simulacrum-define-event-type phony-command)

(simulacrum-define-command phony--evaluate-ast-command (ast)
  "Evaluate AST."
  (phony--evaluate-ast ast))

;;;###autoload
(define-minor-mode phony-mode
  "Toggle phony mode.

When phony mode is enabled, rules will be exported to the speech
recognition backend."
  :global t
  :group 'phony
  (if phony-mode
      (progn
        (phony-request-export)
        (keymap-global-set "<phony-command>" #'phony--evaluate-ast-command))
    (keymap-global-unset "<phony-command>" t)))

(defun phony-generate-event (ast)
  "Evaluate AST via `simulacrum-generate-event'."
  (simulacrum-generate-event 'phony-command ast))

(defun phony--evaluate (ast)
  "Evaluate AST using `phony-ast-evaluation-function'.

This is the actual function that gets invoked when a command is
recognized.  This function exists as a proxy to the evaluation function
so that it may be changed without reloading the grammar."
  (funcall phony-ast-evaluation-function ast))

(defun phony--output-directory (&rest components)
  "Get path to output directory.

If provided, COMPONENTS are appended as components in the returned path."
  (apply
   #'file-name-concat
   (expand-file-name phony-output-directory)
   components))

(defun phony--rule-external-name (rule-or-name)
  "Return the speech engine facing name for RULE-OR-NAME.

The external name of a rule is a string, representing how the function
is identified when exported to the speech engine."
  (let ((name (if (symbolp rule-or-name)
                  rule-or-name
                (phony--rule-name rule-or-name))))
    (concat "phony_"
            (replace-regexp-in-string
             (rx (not alnum)) "_" (symbol-name name)))))

(cl-defstruct (phony--grammar-configuration
               (:constructor phony--make-grammar-configuration)
               (:copier nil))
  "A configuration for a grammar."
  ( modules '()
    :type list
    :documentation "List of names of modules to use.
See `phony-define-module' for info on modules.")
  ( enabled-modules '()
    :type list
    :documentation "List of names  of modules that are enabled.")
  ( module-provision (make-hash-table :test 'eq)
    :type hash-table
    :documentation "Hash table mapping which modules resolve interfaces where.
The key names the module whose interfaces are provided in the module
named by the value name."))

(defvar phony--default-grammar-configuration
  (phony--make-grammar-configuration)
  "The current user grammar configuration.")

(cl-defstruct (phony--grammar
               (:constructor phony--make-grammar)
               (:copier nil))
  "A collection of rules."
  ( rules (make-hash-table)
    :type hash-table
    :documentation "Hash table of rules, indexed by name.")
  ( modules (make-hash-table)
    :type hash-table
    :documentation "Hash table of modules, indexed by name.")
  ( module-provision (make-hash-table)
    :type hash-table
    :documentation "Hash table mapping which modules resolve interfaces where.
The key module will have its interfaces resolved in the module it maps
to."))

(defun phony--copy-grammar (grammar)
  "Return a deep copy of GRAMMAR."
  (let ((rules (make-hash-table))
        (modules (make-hash-table)))
    (maphash
     (lambda (name rule)
       (puthash name (phony--copy-rule rule) rules))
     (phony--grammar-rules grammar))
    (maphash
     (lambda (name module)
       (puthash name (phony--copy-module module) modules))
     (phony--grammar-modules grammar))

    (phony--make-grammar
     :rules rules
     :modules modules
     :module-provision
     (copy-hash-table
      (phony--grammar-module-provision grammar)))))

(defmacro phony-provide-from (interface-module provider-module)
  "Set interfaces in INTERFACE-MODULE to find providers in PROVIDER-MODULE.

Providers without a module take precedence over providers in
PROVIDER-MODULE.

See `phony-define-interface' for information on interfaces and
providers."
  `(progn
     (puthash ',interface-module ',provider-module
              (phony--grammar-module-provision phony--default-grammar))
     (puthash ',interface-module ',provider-module
              (phony--grammar-configuration-module-provision
               phony--default-grammar-configuration))))

(defun phony--provides-from-p (interface-module provider-module grammar)
  "Return non-nil if PROVIDER-MODULE resolves INTERFACE-MODULE in GRAMMAR.

PROVIDER-MODULE and INTERFACE-MODULE must be provided by name."
  (eq (gethash interface-module (phony--grammar-module-provision grammar))
      provider-module))

(defvar phony--default-grammar (phony--make-grammar)
  "The current user specification of the grammar.")

(defmacro phony--define-grammar-attribute (name args docstring &rest body)
  "Define a lazily evaluated grammar attribute.

Grammar attributes should only be used for prepared grammars (see
`phony--prepare-grammar').

This defines a function NAME for getting the attribute.  ARGS must
be (grammar) unquoted.  DOCSTRING is the documentation for the attribute
function and BODY defines how to compute the attribute."
  (declare (indent defun)
           (doc-string 3))
  ;; TODO: Fix symbol generation
  ;; TODO: Ensure args is just one parameter named grammar
  `(let ((attribute (make-hash-table :weakness 'key)))
     (defun ,name ,args
       ,docstring
       (with-memoization (map-elt attribute grammar)
         ,@body))))

(cl-defstruct (phony--module
               (:constructor phony--make-module)
               (:copier phony--copy-module))
  "Modules group rules into a unit.
See `phony-define-module' for information on modules."
  ( name nil
    :type symbol
    :documentation
    "Name of this module.")
  ( utterance nil
    :type string
    :documentation
    "Utterance for referring to this module.")
  ( file-name nil
    :type string
    :documentation
    "Filename of the file defining this module.
If nil it is not associated to a particular file.")
  ( enabled-p nil
    :type boolean
    :documentation
    "Whether the rules of this module should be exported."))

(defvar phony--modules-by-name (make-hash-table :test #'equal)
  "All modules, keyed by their name.")

(defun phony--current-file-name ()
  "Return the filename of the current evaluation context.

Returns `load-file-name' if non-nil, otherwise the value of the variable
`buffer-file-name'.  Therefore, if both are nil, this function also
returns nil.

The same file always returns the same path, unless the file has more
than one hardlink."
  (and-let* ((file-name (or load-file-name buffer-file-name)))
    (file-truename file-name)))

(define-multisession-variable phony--enabled-modules '()
  "Names of modules that are enabled across sessions.")

(defun phony--define-module (name &optional utterance file)
  "Define module named NAME.

UTTERANCE is a string specifying how this module is referred to as an
utterance.  FILE, if specified, declares that this module should be the
default for all rules defined in FILE."
  (let ((enabled (memq name (multisession-value phony--enabled-modules))))
    (puthash name
             (phony--make-module
              :name name
              :utterance utterance
              :file-name file
              :enabled-p enabled)
             (phony--grammar-modules phony--default-grammar))
    (cl-pushnew
     name
     (phony--grammar-configuration-modules
      phony--default-grammar-configuration))
    (when enabled
      (cl-pushnew
       name
       (phony--grammar-configuration-enabled-modules
        phony--default-grammar-configuration)))
    (when utterance
      (phony-dictionary-put utterance 'phony-module name))
    name))

(defmacro phony-define-module (name &optional utterance)
  "Define a module NAME.

Rules can be associated to modules through the :module parameter.

A module can be disabled or enabled.  While it is disabled, the rules
associated to it are changed to not be interactive and contributions to
rules outside the module are removed.  See the documentation of
`phony-defun' for more information on interactivity and contributions.
Disabled rules can still be referenced by other rules, and will partake
in the grammar.

By default, newly defined modules are disabled.  To enable a module, use
`phony-enable-module'.

If all the rules of a file are part of the same module, use
`phony-module' instead of this macro.

If given, UTTERANCE is a string specifying how this module is referred
to as an utterance."
  `(phony--define-module ',name ',utterance nil))

(defmacro phony-module (name &optional utterance)
  "Declare current file a phony module.

This will define a new module named NAME.  Rules declared in the file
that this form is evaluated in will be assigned to that module, unless
the :module argument has been given for the rule.

A module can be disabled or enabled.  See the documentation of
`phony-define-module' for information on this.  A module is disabled by
default.

If given, UTTERANCE is a string specifying how this module is referred
to as an utterance."
  `(let ((file (phony--current-file-name)))
     (cl-assert file nil
                "Could not determine the file for module `%s'"
                ',name)
     (phony--define-module ',name ',utterance file)))

(defun phony--current-module ()
  "Return the name of the current module.

If the currently loaded or visited file does not define a module with
`phony-module', this function returns nil."
  (and-let* ((current-file (phony--current-file-name))
             (module (seq-find
                      (lambda (module)
                        (equal current-file
                               (phony--module-file-name module)))
                      (phony--modules phony--default-grammar))))
    (phony--module-name module)))

(defun phony--modules (grammar)
  "Return list of all modules in GRAMMAR."
  (map-values (phony--grammar-modules grammar)))

(defun phony--get-module (name grammar)
  "Return module with NAME in GRAMMAR.

If no such module exists, this function returns nil."
  (seq-find (lambda (module) (eq (phony--module-name module) name))
            (phony--modules grammar)))

(defun phony-enable-module (name &optional persist)
  "Enable module NAME.

If PERSIST is non-nil, the module will stay enabled across sessions.

Unless a module is enabled, the rules belonging to it are
non-interactive and don't contribute to open rules."
  (interactive (let* ((name (intern (completing-read
                                     "Enable phony module: "
                                     (seq-map #'phony--module-name
                                              (seq-remove #'phony--module-enabled-p
                                                          (phony--modules
                                                           phony--default-grammar))))))
                      (persist (y-or-n-p (format "Enable %s for future sessions? " name))))
                 (list name persist)))
  (cl-assert (phony--get-module name phony--default-grammar) nil
             "No module named %s" name)
  (setf (phony--module-enabled-p (phony--get-module name phony--default-grammar)) t)
  (cl-pushnew name (phony--grammar-configuration-enabled-modules
                    phony--default-grammar-configuration))
  (when persist
    (cl-pushnew name (multisession-value phony--enabled-modules)))
  (phony-request-export)
  (message "Enabled %s module" name))

(defun phony-disable-module (name &optional persist)
  "Disable module NAME.

If PERSIST is non-nil, the module will stay disabled across sessions.

Rules belonging to disabled modules are never interactive and never
contribute to open rules."
  (interactive (let* ((name (intern (completing-read
                                     "Disable phony module: "
                                     (seq-map #'phony--module-name
                                              (seq-filter #'phony--module-enabled-p
                                                          (phony--modules
                                                           phony--default-grammar))))))
                      (persist (y-or-n-p (format "Disable %s for future sessions? " name))))
                 (list name persist)))
  (cl-assert (phony--get-module name phony--default-grammar) nil
             "No module named %s" name)
  (setf (phony--module-enabled-p
         (phony--get-module name phony--default-grammar))
        nil)
  (setf (phony--grammar-configuration-enabled-modules
         phony--default-grammar-configuration)
        (delq name (phony--grammar-configuration-enabled-modules
                    phony--default-grammar-configuration)))
  (when persist
    (setf (multisession-value phony--enabled-modules)
          (delq name (multisession-value phony--enabled-modules))))
  (phony-request-export)
  (message "Disabled %s module" name))

(cl-defstruct (phony--rule
               (:constructor nil)
               (:copier nil))
  "A rule for matching an utterance."
  ( name nil
    :type symbol
    :documentation "The name of this rule.")
  ( documentation nil
    :type string
    :documentation "The documentation string for this rule.")
  ( module nil
    :type symbol
    :documentation "Name of the module this rule belongs to.
Modules are specified with `phony-define-module' or `phony-module'.  Its
value is nil if it is not part of a module.")
  ( file-name nil
    :type string
    :documentation "The filename of the file where this rule was defined.
Its value is nil if it was not evaluated from a file.")
  ( modes '(global)
    :type list
    :documentation "A list of modes under which this rule is active.
If none of the modes are active, this rule cannot be matched.  A
special case is the \\='global symbol, which indicates that the rule
should always be active.")
  ( contributes-to '()
    :type list
    :documentation "A list of open rules that this rule contributes to.
See documentation for `phony-define-open-rule'.")
  ( provides nil
    :type symbol
    :documentation "An interface this rule is a provider of.
See documentation for `phony-define-interface'.")
  ( virtual-p nil
    :type boolean
    :documentation "Whether this rule was generated by a compilation pass."))

(defun phony--rule-active-p (rule)
  "Return non-nil if RULE is active.

A rule is inactive if none of its modes are currently active."
  (let ((modes (phony--rule-modes rule)))
    (or
     (memq 'global modes)
     (derived-mode-p modes)
     (seq-some (lambda (mode)
                 (or
                  (memq mode local-minor-modes)
                  (memq mode global-minor-modes)))
               modes))))

(defun phony--rule-always-active-p (rule _grammar)
  "Return non-nil if RULE is guaranteed to always be active in GRAMMAR.

A rule is always active if it is global."
  (memq 'global (phony--rule-modes rule)))

(cl-defstruct (phony--procedure-rule
               (:include phony--rule)
               (:constructor phony--make-procedure-rule))
  "A rule mapping an utterance pattern to a function call."
  ( function '()
    :type function
    :documentation "Function to call when the utterance is matched.")
  ( element nil
    :type phony--element-sequence
    :documentation "Parsed element tree for the utterance pattern.")
  ( arglist '()
    :type (repeat symbol)
    :documentation "List of argument symbols extracted from the pattern.")
  ( interactive-p t
    :type boolean
    :documentation "\
Whether this rule can be invoked directly.
Non-interactive rules are only reachable as sub-rules within other rules.")
  ( anchor-beginning-p nil
    :type boolean
    :documentation "\
Constrain matching to the start of an utterance, like `^' in regex.")
  ( anchor-end-p nil
    :type boolean
    :documentation "\
Constrain matching to the end of an utterance, like `$' in regex."))

(cl-defstruct (phony--open-rule
               (:include phony--rule)
               (:constructor phony--make-open-rule))
  "A rule that matches any of its alternatives."
  ( alternatives nil
    :type (repeat symbol)
    :documentation "List of symbols naming the alternative rules."))

(cl-defstruct (phony--dictionary
               (:include phony--rule)
               (:constructor nil)
               (:constructor phony--make-dictionary))
  "A dictionary mapping utterances to values."
  ( mapping nil
    :type list
    :documentation "An alist mapping utterances, strings, to values."))

(cl-defstruct (phony--interface-rule
               (:include phony--rule)
               (:constructor phony--make-interface-rule))
  "An interface rule to be replaced by a provider.

See documentation for `phony-define-interface'."
  ( default nil
    :type symbol
    :documentation
    "The default provider for this interface.
If this is nil, there is no default provider."))

(defun phony--copy-rule-base-inplace (source target)
  "Copy base `phony--rule' slots from SOURCE into TARGET."
  (setf (phony--rule-name target) (phony--rule-name source))
  (setf (phony--rule-documentation target) (phony--rule-documentation source))
  (setf (phony--rule-module target) (phony--rule-module source))
  (setf (phony--rule-file-name target) (phony--rule-file-name source))
  (setf (phony--rule-modes target)
        (copy-sequence (phony--rule-modes source)))
  (setf (phony--rule-contributes-to target)
        (copy-sequence (phony--rule-contributes-to source)))
  (setf (phony--rule-virtual-p target) (phony--rule-virtual-p source))
  (setf (phony--rule-provides target) (phony--rule-provides source))
  target)

(cl-defgeneric phony--copy-rule (rule)
  "Return a deep copy of RULE.")

(cl-defmethod phony--copy-rule ((rule phony--procedure-rule))
  "Return a deep copy of RULE."
  (let ((copy (phony--make-procedure-rule
               :function (phony--procedure-rule-function rule)
               :element (phony--copy-element (phony--procedure-rule-element rule))
               :arglist (copy-sequence (phony--procedure-rule-arglist rule))
               :interactive-p (phony--procedure-rule-interactive-p rule)
               :anchor-beginning-p (phony--procedure-rule-anchor-beginning-p rule)
               :anchor-end-p (phony--procedure-rule-anchor-end-p rule))))
    (phony--copy-rule-base-inplace rule copy)))

(cl-defmethod phony--copy-rule ((rule phony--open-rule))
  "Return a deep copy of RULE."
  (let ((copy (phony--make-open-rule
               :alternatives (copy-sequence
                              (phony--open-rule-alternatives rule)))))
    (phony--copy-rule-base-inplace rule copy)))

(cl-defmethod phony--copy-rule ((rule phony--dictionary))
  "Return a deep copy of RULE."
  (let ((copy (phony--make-dictionary
               :mapping (copy-alist (phony--dictionary-mapping rule)))))
    (phony--copy-rule-base-inplace rule copy)))

(cl-defmethod phony--copy-rule ((rule phony--interface-rule))
  "Return a deep copy of RULE."
  (let ((copy (phony--make-interface-rule
               :default (phony--interface-rule-default rule))))
    (phony--copy-rule-base-inplace rule copy)))

(defun phony--internalize-contributions (grammar)
  "Insert all contributions to open rules as alternatives.

This mutates GRAMMAR so that all contributions are directly reflected by
the `phony--open-rule-alternatives' field."
  (maphash
   (lambda (name rule)
     (seq-doseq (contribution (phony--rule-contributes-to rule))
       (push name (phony--open-rule-alternatives
                   (phony--get-rule contribution grammar))))
     (setf (phony--rule-contributes-to rule) nil))
   (phony--grammar-rules grammar)))

(cl-defgeneric phony--substitute-in-rule (rule from to)
  "Change references to rule FROM to rule TO in RULE.

This function assumes that contributions have been internalized.  See
`phony--internalize-contributions'.")

(cl-defmethod phony--substitute-in-rule ((rule phony--open-rule) from to)
  "Change references to rule FROM to rule TO in RULE."
  (setf (phony--open-rule-alternatives rule)
        (seq-map (lambda (alternative)
                   (if (eq alternative from)
                       to
                     alternative))
                 (phony--open-rule-alternatives rule))))

(cl-defmethod phony--substitute-in-rule ((rule phony--dictionary) _from _to)
  "Change references to rule FROM to rule TO in RULE."
  rule)

(cl-defmethod phony--substitute-in-rule ((rule phony--procedure-rule) from to)
  "Change references to rule FROM to rule TO in RULE."
  (setf (phony--procedure-rule-element rule)
        (phony--element-transform
         (lambda (element)
           (if (and (phony--element-rule-p element)
                    (eq (phony--element-rule-name element) from))
               (make-phony--element-rule :name to)
             element))
         (phony--procedure-rule-element rule))))

(cl-defmethod phony--substitute-in-rule ((rule phony--interface-rule) _from _to)
  "Change references to rule FROM to rule TO in RULE."
  rule)

(defun phony--substitute-in-grammar (grammar from to)
  "Change references to rule FROM to rule TO in GRAMMAR."
  (seq-doseq (rule (map-values (phony--grammar-rules grammar)))
    (phony--substitute-in-rule rule from to)))

(defun phony--replace-in-grammar (grammar from to)
  "Remove FROM and change references to rule FROM to rule TO in GRAMMAR."
  (phony--substitute-in-grammar grammar from to)
  (remhash from (phony--grammar-rules grammar)))

(defun phony--interactive-rules (grammar)
  "Return the interactive rules of GRAMMAR."
  (seq-filter
   (lambda (rule) (and (phony--procedure-rule-p rule)
                       (phony--procedure-rule-interactive-p rule)))
   (phony--get-rules grammar)))

(defun phony--products (rule)
  "Return the names of the rules that may occur as submatches of RULE.

This does not resolve interfaces nor contributions to open rules."
  (cl-typecase rule
    (phony--procedure-rule
     (seq-map #'phony--element-rule-name
              (phony--collect #'phony--element-rule-p
                              (phony--procedure-rule-element rule))))
    (phony--open-rule
     (phony--open-rule-alternatives rule))
    (phony--dictionary
     '())
    (phony--interface-rule
     '())
    (t
     (error "Internal phony error, please submit a bug report: `phony--products' typecase failed for %s"
            rule))))

(defun phony--user-rule-p (rule)
  "Return non-nil if RULE is a user rule.

A rule is a user rule when it is not part of a module.  This is
interpreted as the rule being part of the user's personal configuration."
  (not (phony--rule-module rule)))

(defun phony--remove-unreachable-resolve-interfaces (grammar)
  "Remove unreachable rules and replace interfaces with their providers.

This mutates GRAMMAR so that references to an interface rule instead
reference the provider of the interface.  The interface rules are
removed from the grammar.  In addition, any rules that cannot be reached
are removed.

This function assumes `phony--internalize-contributions' has been
applied to the grammar."
  ;; Removing unreachables and resolving interfaces must be done as
  ;; one, because we should only error on unresolved interfaces if
  ;; they are reachable, but reachability in turn depends on interface
  ;; resolution.
  (let* ((rules (phony--get-rules grammar))
         (providers
          (seq-filter #'phony--rule-provides rules))
         (interface-resolution-map
          (seq-keep (lambda (provider)
                      (and (or (phony--user-rule-p provider)
                               (let ((provider-module (phony--rule-module provider))
                                     (interface-module (phony--rule-module
                                                        (phony--get-rule
                                                         (phony--rule-provides provider)
                                                         grammar))))
                                 (phony--provides-from-p
                                  interface-module provider-module grammar)))
                           (cons
                            (phony--rule-provides provider)
                            (phony--rule-name provider))))
                    providers))
         (worklist (mapcar #'phony--rule-name
                           (phony--interactive-rules grammar)))
         (reachable (make-hash-table :test 'eq)))
    (while worklist
      (let* ((current (pop worklist)))
        (unless (gethash current reachable)
          (puthash current current reachable)
          (dolist (task (phony--products (phony--get-rule current grammar)))
            (unless (phony--get-rule task grammar)
              (error "Rule `%s' references undefined rule `%s'"
                     current task))
            (unless (gethash task reachable)
              (push task worklist)))
          (when (phony--interface-rule-p
                 (phony--get-rule current grammar))
            (let ((providers (seq-keep (lambda (entry)
                                         (and (eq (car entry) current)
                                              (cdr entry)))
                                       interface-resolution-map)))
              ;; If rules in the user's configuration provide for the
              ;; interface, they take precedence.
              (when-let* ((user-providers
                           (seq-filter (lambda (provider)
                                         (phony--user-rule-p
                                          (phony--get-rule provider grammar)))
                                       providers)))
                (setq providers user-providers))
              ;; :default provider has lowest priority
              (unless providers
                (when-let* ((default
                             (phony--interface-rule-default
                              (phony--get-rule current grammar))))
                  (unless (phony--get-rule default grammar)
                    (error "The default provider `%s' for interface %s is not defined"
                           default current))
                  (setq providers (list default))))
              (when (> (length providers) 1)
                (error "More than one eligible provider available for %s\nProviders: %s"
                       current
                       (string-join (seq-map #'symbol-name providers) ", ")))
              (when (= (length providers) 0)
                ;; TODO: Hint about providers in non-selected modules
                (error "No eligible provider available for %s"
                       current))
              (phony--replace-in-grammar grammar current (car providers))
              (unless (gethash (car providers) reachable)
                (push (car providers) worklist)))))))
    (dolist (rule (phony--get-rules grammar))
      (let ((name (phony--rule-name rule)))
        (unless (gethash name reachable)
          (remhash name (phony--grammar-rules grammar)))))))

(defun phony--seal-disabled-modules (grammar)
  "Remove external impact of disabled modules in GRAMMAR.

This removes interactivity and contributions to rules external to the
module from rules in disabled modules."
  (dolist (rule (phony--get-rules grammar))
    (when (and (phony--rule-module rule)
               (not (phony--module-enabled-p (phony--get-module
                                              (phony--rule-module rule)
                                              grammar))))
      (setf (phony--rule-contributes-to rule)
            (seq-filter (lambda (name)
                          (eq
                           (phony--rule-module rule)
                           (phony--rule-module
                            (phony--get-rule name grammar))))
                        (phony--rule-contributes-to rule)))
      (when (phony--procedure-rule-p rule)
        (setf (phony--procedure-rule-interactive-p rule) nil)))))

(define-error 'phony--interface-cycle "Cycle in providers")

(defun phony--detect-interface-cycles (grammar)
  "Error if there is a rule provision cycle in GRAMMAR."
  (let* ((rules (phony--get-rules grammar))
         (providers (seq-filter #'phony--rule-provides rules))
         (provision-map
          (map-into (seq-map (lambda (provider)
                               (cons provider
                                     (phony--get-rule
                                      (phony--rule-provides provider)
                                      grammar)))
                             providers)
                    '(hash-table :test eq))))
    (dolist (provider providers)
      (let ((current provider)
            (cycle (list provider))
            (visited (make-hash-table :test 'eq)))
        (while current
          (puthash current t visited)
          (setq current (gethash current provision-map))
          (push current cycle)
          (when (gethash current visited)
            (signal 'phony--interface-cycle
                    (seq-map
                     #'phony--rule-name
                     ;; Emacs 31: drop-while
                     (seq-drop-while (lambda (rule) (not (eq rule current)))
                                     (nreverse cycle))))))))))

(defun phony--canonicalize-grammar (grammar)
  "Rewrite GRAMMAR into canonical form.

In canonical form, all alternatives in open rules are order
lexicographically on name."
  (maphash
   (lambda (_name rule)
     (when (phony--open-rule-p rule)
       (setf (phony--open-rule-alternatives rule)
             (seq-sort-by
              #'symbol-name #'string<
              (phony--open-rule-alternatives rule)))))
   (phony--grammar-rules grammar)))

(defun phony--detect-non-open-contributions (grammar)
  "Throw error if GRAMMAR contains rules who contribute to non-open rules.

This function also checks for contributions to non-existent rules."
  (dolist (rule (phony--get-rules grammar))
    (dolist (contribution (phony--rule-contributes-to rule))
      (let ((lookup (phony--get-rule contribution grammar)))
        (unless lookup
          (error "Rule `%s' contributes to undefined rule `%s'"
                 (phony--rule-name rule) contribution))
        (unless (phony--open-rule-p lookup)
          (error "Rule `%s' contributes to non-open rule `%s'"
                 (phony--rule-name rule) contribution))))))

(defun phony--prepare-grammar (grammar)
  "Prepare GRAMMAR for export.

The returned grammar must not be mutated."
  (let ((prepared (phony--copy-grammar grammar)))
    (phony--seal-disabled-modules prepared)
    (phony--detect-non-open-contributions prepared)
    (phony--internalize-contributions prepared)
    (phony--detect-interface-cycles prepared)
    (phony--remove-unreachable-resolve-interfaces prepared)
    (phony--canonicalize-grammar prepared)
    prepared))

(defvar phony--exported-grammar (phony--make-grammar)
  "The most recently exported grammar.

This is `phony--default-grammar' after going through preparation.  The
grammar object should never be mutated.")

(defun phony--get-rules (grammar)
  "Return a list containing the rules of GRAMMAR."
  (hash-table-values (phony--grammar-rules grammar)))

(defun phony--get-rule (name grammar)
  "Return the rule named NAME in GRAMMAR.
Return nil if no such rule exists."
  (gethash name (phony--grammar-rules grammar)))

(defun phony--add-rule (rule grammar)
  "Add RULE to GRAMMAR.

If the module of RULE is nil but is declared in a file with a
`phony-module' declaration, then the module of RULE is set to that
module.

This function must be invoked every time a rule is declared."
  (unless (phony--rule-module rule)
    (setf (phony--rule-module rule) (phony--current-module)))
  (setf (phony--rule-file-name rule) (phony--current-file-name))
  (puthash (phony--rule-name rule)
           rule
           (phony--grammar-rules grammar)))

(defun phony-remove-rule (rule-name)
  "Remove rule named RULE-NAME."
  (interactive (list
                (intern (completing-read
                         "Remove rule: "
                         (hash-table-keys
                          (phony--grammar-rules phony--default-grammar))))))
  (let ((grammar phony--default-grammar))
    (remhash rule-name (phony--grammar-rules grammar))
    (seq-doseq (open-rule (seq-filter
                           #'phony--open-rule-p
                           (phony--get-rules grammar)))
      (setf (phony--open-rule-alternatives open-rule)
            (remove rule-name (phony--open-rule-alternatives open-rule))))
    (phony-request-export)))

(defun phony--add-new-rule (constructor parameters)
  "Add a new rule from CONSTRUCTOR with PARAMETERS.

Instead of constructing the rule directly, functions that add rules
invoke this function.  This function validates that the parameters are
correcly formed, and performs some standard transformations from
interface sugar to the form used internally."
  ;; TODO: Document what is meant by "sugar".

  ;; We will be destructively modifying the parameter list, so copy
  ;; it.  All modifications are shallow.
  (setq parameters (apply #'list parameters))

  ;; NOTE: The external parameter is named :mode, but internally we
  ;; normalize it to a list :modes.
  (when-let* ((mode (map-elt parameters :mode)))
    (when (and (listp mode) (eq (car mode) 'quote))
      (error ":mode keyword argument must be unquoted"))
    (setf (map-elt parameters :modes)
          (ensure-list (map-elt parameters :mode)))
    (cl-remf parameters :mode))

  (when-let* ((contributes-to (map-elt parameters :contributes-to)))
    (when (and (listp contributes-to) (eq (car contributes-to) 'quote))
      (error ":contributes-to keyword argument must be unquoted"))
    (setq contributes-to (ensure-list contributes-to))
    (unless (seq-every-p #'symbolp contributes-to)
      (error ":contributes-to keyword argument must be a symbol or a list of symbols"))
    (setf (map-elt parameters :contributes-to) contributes-to))

  (when-let* ((provides (map-elt parameters :provides)))
    (when (and (listp provides) (eq (car provides) 'quote))
      (error ":provides keyword argument must be unquoted"))
    (unless (symbolp provides)
      (error ":provides keyword argument must be a symbol")))

  (when-let* ((module (map-elt parameters :module)))
    (when (and (listp module) (eq (car module) 'quote))
      (error ":module keyword argument must be unquoted"))
    (unless (symbolp module)
      (error ":module keyword argument must be a symbol")))

  (phony--add-rule (apply constructor parameters)
                   phony--default-grammar))

(defun phony--ensure-dictionary (dictionary)
  "Return the dictionary rule named DICTIONARY in `phony--default-grammar'.

If the rule does not exist or is not a dictionary, an error is
signalled."
  (let ((rule (phony--get-rule dictionary phony--default-grammar)))
    (unless rule
      (error "No rule named `%s'" dictionary))
    (unless (phony--dictionary-p rule)
      (error "Rule `%s' is not a dictionary" dictionary))
    rule))

(defun phony-dictionary-get (utterance dictionary)
  "Return the value corresponding to UTTERANCE in DICTIONARY.
If no such value exists, return nil.

DICTIONARY is the name of the dictionary to modify."
  (alist-get utterance
             (phony--dictionary-mapping (phony--ensure-dictionary dictionary))
             nil nil #'string-equal))

(defun phony-dictionary-put (utterance dictionary value)
  "Set the value of UTTERANCE in DICTIONARY to VALUE.

DICTIONARY is the name of the dictionary to modify.

Invoking this function will resync the dictionary to the external speech
recognition engine."
  (setf (alist-get utterance
                   (phony--dictionary-mapping (phony--ensure-dictionary dictionary))
                   nil nil #'string-equal)
        value)
  (phony--request-export-dictionaries))

(defun phony-dictionary-remove (utterance dictionary)
  "Remove UTTERANCE from DICTIONARY.

DICTIONARY is the name of the dictionary to modify.

Invoking this function will resync the dictionary to the external speech
recognition engine."
  (setf (alist-get utterance
                   (phony--dictionary-mapping (phony--ensure-dictionary dictionary))
                   nil t #'string-equal)
        nil)
  (phony--request-export-dictionaries))

(defun phony-dictionary-alist (dictionary)
  "Return the mapping of DICTIONARY as an alist.

DICTIONARY is the name of the dictionary to modify."
  (phony--dictionary-mapping (phony--ensure-dictionary dictionary)))

(defun phony-set-dictionary-alist (dictionary alist)
  "Set the mapping of DICTIONARY to ALIST.

DICTIONARY is the name of the dictionary to modify.

Invoking this function will resync the dictionary to the external speech
recognition engine."
  (setf (phony--dictionary-mapping (phony--ensure-dictionary dictionary)) alist)
  (phony--request-export-dictionaries))

(gv-define-setter phony-dictionary-get (value utterance dictionary)
  `(phony-dictionary-put ,utterance ,dictionary ,value))

(gv-define-setter phony-dictionary-alist (value dictionary)
  `(phony-set-dictionary-alist ,dictionary ,value))

(defun phony--create-lookup-representation (entry dictionary)
  "Create lookup string for ENTRY in DICTIONARY.

When evaluating the returned string from emacsclient, this performs
the lookup."
  (format "(%s \"%s\")"
          (phony--dictionary-name dictionary)
          (car entry)))

(defun phony--prepare-dictionary-for-serialization (dictionary)
  "Return DICTIONARY as an entry for `json-serialize'.

This represents one key-value pair, mapping the external dictionary name
to its dictionary."
  (cons (make-symbol (phony--rule-external-name dictionary))
        (mapcar (lambda (entry)
                  (cons
                   (make-symbol (car entry))
                   ;; Each value is a string, encoding a form that
                   ;; will evaluate to the actual value.
                   (phony--create-lookup-representation
                    entry dictionary)))
                (phony--dictionary-mapping dictionary))))

;; TODO: Handle IO errors
(defun phony--write-dictionaries-to-file ()
  "Write dictionaries to dictionaries.json.

The speech recognition backend can read this file to register the
dictionaries."
  (mkdir (phony--output-directory) t)
  (with-temp-file (phony--output-directory "dictionaries.json")
    (json-insert
     (mapcar #'phony--prepare-dictionary-for-serialization
             (seq-filter #'phony--dictionary-p
                         (phony--get-rules phony--default-grammar))))))

(defvar phony--dictionary-export-function #'phony--write-dictionaries-to-file
  "Function called to export dictionaries.")

(defun phony--export-dictionaries ()
  "Export dictionaries using `phony--dictionary-export-function'."
  (funcall phony--dictionary-export-function))

(defvar phony--debounce-export-requests t
  "Non-nil to debounce export requests via idle timers.
When nil, export requests are executed synchronously.")

(defun phony--request-export-dictionaries ()
  "Sync DICTIONARY-NAMES when next idle.

If `phony-mode' is disabled, this function does nothing."
  (interactive)
  (when phony-mode
    (if phony--debounce-export-requests
        (phony--debounce #'phony--export-dictionaries)
      (phony--export-dictionaries))))

(cl-defun phony--define-dictionary (arguments)
  "Define a dictionary from ARGUMENTS.

See documentation of `phony-define-dictionary' for more information."
  (let ((mapping (plist-get arguments :mapping))
        (name (plist-get arguments :name)))
    (unless (plist-member arguments :mapping)
      (error "Required mapping for %s not provided" name))

    (unless (proper-list-p mapping)
      (error "The mapping of %s must be a list" name))

    (when-let* ((non-cons (seq-find (lambda (x) (not (consp x))) mapping)))
      (error "The mapping of %s must be a alist, but %S is not a cons cell"
             name non-cons))

    (when-let* ((non-string-key (seq-find
                                 (lambda (entry) (not (stringp (car-safe entry))))
                                 mapping)))
      (error "The keys of %s must be strings, but %S is not a string"
             name (car non-string-key))))

  (phony--add-new-rule #'phony--make-dictionary arguments)

  (if (or (map-elt arguments :contributes-to)
          (and (map-elt arguments :mode)
               (not (memq 'global (ensure-list (map-elt arguments :mode))))))
      (phony-request-export)
    (phony--request-export-dictionaries)))

(eval-and-compile
  ;; This function is used in the rule defining macros.  The byte
  ;; compiler does not evaluate function definitions, so when we later
  ;; in this file define some rules, an error is emitted if we don't
  ;; wrap the definition in eval-and-compile.
  (defun phony--split-keywords-rest (declaration-args)
    "Split DECLARATION-ARGS into keyword arguments and rest arguments.

Keyword arguments are assumed to occur first.  Returns a cons-cell with
the car being a plist of the keyword arguments and the cdr the rest
arguments."
    (let ((arguments '()))
      (while (keywordp (car declaration-args))
        (push (seq-take declaration-args 2) arguments)
        (setq declaration-args (seq-drop declaration-args 2)))
      (cons (apply #'append arguments) declaration-args))))

(defmacro phony-define-dictionary (name &rest arguments)
  ;; checkdoc-params: (arguments)
  "Define a dictionary with NAME containing ALIST.

ALIST is an alist mapping utterances to values.  An utterance is a
string containing the spoken form for referencing the value.  The
defined rule matches on any of the keys and evaluates to the
corresponding value.

See `phony-defun' for a list of optional arguments available across all
rule types.

\(fn NAME [DOCSTRING] [KEY VALUE]... ALIST)"
  (declare (indent defun)
           (doc-string 2))
  (let ((documentation (and (stringp (car arguments)) (pop arguments))))
    (pcase-let* ((`(,optional-arguments . (,mapping))
                  (phony--split-keywords-rest arguments)))
      `(phony--define-dictionary
        (append (list :name ',name
                      :documentation ,documentation
                      :mapping ,mapping)
                ',optional-arguments)))))

(cl-defun phony--define-open-rule (arguments)
  "Define an open rule from ARGUMENTS.

See documentation of `phony-define-open-rule' for more information."
  (phony--add-new-rule #'phony--make-open-rule arguments)
  (phony-request-export)
  (map-elt arguments :name))

(defmacro phony-define-open-rule (name &rest arguments)
  ;; checkdoc-params: (arguments)
  "Define NAME as an open rule.

Open rules match any of the rules specified by the optional
:alternatives keyword argument.  :alternatives should be an unquoted
list, and defaults to the empty list.  Other rules may add themselves to
the list of alternatives by specifying this rule in their
:contributes-to argument.

The value of matching this rule is the value of matching the
corresponding alternative.

See `phony-defun' for a list of optional arguments available across all
rule types.

\(fn NAME [DOCSTRING] [KEY VALUE]...)"
  (declare (indent defun)
           (doc-string 2))
  (let ((documentation (and (stringp (car arguments)) (pop arguments))))
    `(phony--define-open-rule
      (append (list :name ',name
                    :documentation ,documentation)
              ',arguments))))

(defun phony--define-interface (arguments)
  "Define an interface rule from ARGUMENTS.

See `phony-define-interface' for documentation on interface rules."
  (when-let* ((default (map-elt arguments :default)))
    (unless (symbolp default)
      (error ":default keyword argument must be an unquoted symbol")))
  (phony--add-new-rule #'phony--make-interface-rule arguments)
  (phony-request-export)
  (map-elt arguments :name))

(defmacro phony-define-interface (name &rest arguments)
  ;; checkdoc-params: (arguments)
  "Define NAME as an interface rule.

Interface rules do not carry a definition.  Instead, their behaviour is
provided by other rules through the `:provides' keyword.  Such rules are
providers of the interface.

Providers are looked up in the following order:

- If there is a provider without a module, use that rule.  Such a
  provider is called a user provider, and is assumed to be part of the
  user's configuration.

- Otherwise, if a module has been selected for provider lookup with
  `phony-provide-from', use the provider from that module.

- Otherwise, if the :default optional argument has been given to this
  interface, use that provider.

Optional arguments can be given with keyword arguments KEY and VALUE.
Optional arguments are:

  :default           The default provider for this interface.  Defaults
                     to nil, which means no default.

See `phony-defun' for a list of optional arguments available across all
rule types.

\(fn NAME [DOCSTRING] [KEY VALUE]...)"
  (declare (indent defun)
           (doc-string 2))
  (let ((documentation (and (stringp (car arguments)) (pop arguments))))
    `(phony--define-interface
      (append (list :name ',name
                    :documentation ,documentation)
              ',arguments))))

(defun phony--collect (predicate element)
  "Return list of descendants of ELEMENT matching PREDICATE.

If ELEMENT matches PREDICATE, it will be part of the list.  Matches are
returned in the same order that they occur in ELEMENT."
  (let ((collected-children
         (seq-mapcat
          (apply-partially #'phony--collect predicate)
          (phony--element-children element))))
    (if (funcall predicate element)
        (cons element collected-children)
      collected-children)))

(cl-defstruct (phony--analysis-data
               (:constructor nil)
               (:constructor phony--make-analysis-data))
  "Storage struct for results of statically analyzing the grammar."
  (productions
   (make-hash-table)
   :type hash-table
   :documentation "Hash table mapping a rule to a list of its submatches.
A production of a rule is a rule whose match is included in the
producing rule's match.  If a production is matched multiple times, it
is duplicated.")
  (producers
   (make-hash-table)
   :type hash-table
   :documentation "Hash table mapping a rule to a list of rules it is a submatch of.
A producer of a rule is a rule whose match includes this rule's match.
If a rule is produced multiple times, it is duplicated.")
  (cycle
   nil
   :type list
   :documentation "If non-nil, a sequence of rule names forming a dependency cycle.")
  (contains-errors
   nil
   :type boolean
   :documentation "Whether the analysis detected errors in the grammar.")
  (linear-extension
   nil
   :type list
   :documentation "Linear extension of the dependency graph.
Also commonly known as topological order.  Rules occurring in this list
are guaranteed to only depend on preceding rules.")
  (grammar
   nil
   :type phony--grammar
   :documentation "The grammar that was analyzed."))

(defun phony--get-productions (analysis-data rule)
  ;; checkdoc-params: (analysis-data)
  "Get list of rules that are submatches of RULE.

If a rule is a submatch multiple times, it will also occur as many times
in the returned list."
  (gethash rule (phony--analysis-data-productions analysis-data)))

(defun phony--get-producers (analysis-data rule)
  ;; checkdoc-params: (analysis-data)
  "Get list of rules whose match includes RULE as a submatch.

If a rule includes RULE multiple times, it will also occur as many times
in the returned list."
  (gethash rule (phony--analysis-data-producers analysis-data)))

(defun phony--maximum-producer-multiplicity (analysis-data rule)
  ;; checkdoc-params: (analysis-data)
  "Return maximum amount of times RULE is produced by a single rule."
  (thread-last
    (phony--get-producers analysis-data rule)
    (seq-map #'phony--rule-name)
    (seq-map #'symbol-name)
    (seq-sort #'string<)
    (seq-group-by #'identity)
    (seq-map #'cdr)
    (seq-map #'length)
    (apply #'max 0)))

(defun phony--populate-dependency-graph (analysis-data grammar)
  "Populate the dependency graph of ANALYSIS-DATA from GRAMMAR.

If an undefined rule is mentioned in some element, a warning will be
emitted and `phony--analysis-data-contains-errors' will be set to t."
  (let ((productions (make-hash-table))
        (producers (make-hash-table))
        (undefined-references (make-hash-table)))
    (seq-doseq (rule (phony--get-rules grammar))
      (puthash rule '() productions)
      (puthash rule '() producers))
    (seq-doseq (rule (phony--get-rules grammar))
      (seq-doseq (reference (phony--products rule))
        (if-let* ((reference-rule (phony--get-rule reference grammar)))
            (progn
              (push reference-rule (gethash rule productions))
              (push rule (gethash reference-rule producers)))
          (cl-pushnew (phony--rule-name rule)
                      (gethash reference undefined-references))
          (oset analysis-data contains-errors t))))
    (oset analysis-data productions productions)
    (oset analysis-data producers producers)
    (maphash
     (lambda (name mentioner-names)
       (display-warning
        'phony
        (format "Rule %S is not defined (required by %s)"
                name
                (mapconcat (lambda (n) (format "%S" n))
                           mentioner-names ", "))))
     undefined-references)))

(defun phony--try-linear-extension-impl (rule visited finished analysis-data)
  "Find linear extension of dependency graph in ANALYSIS-DATA.

This function assumes that `phony--analysis-data-productions' has been
populated in ANALYSIS-DATA.

This function populates `phony--analysis-data-linear-extension' in
ANALYSIS-DATA.  If a cycle is detected
`phony--analysis-data-contains-errors' is set to t and the cycle is
returned without visiting any more rules.  Otherwise, this function
returns nil.

RULE is the currently visited rule.  VISITED is a hash table of the
already visited rules.  FINISHED is a hash table of rules that have been
fully processed.  This function adds RULE to VISITED before recusing to
its children, and to FINISHED afterwards."
  (let ((dependencies (oref analysis-data productions)))
    (cl-block nil
      (when (gethash rule finished)
        (cl-return nil))
      (when (gethash rule visited)
        (cl-return (list rule)))

      (puthash rule t visited)
      (seq-doseq (dependency (gethash rule dependencies))
        (when-let* ((path (phony--try-linear-extension-impl
                           dependency visited finished analysis-data)))
          (if (and (not (length= path 1))
                   (eq (seq-first path) (car (last path))))
              (cl-return path)
            (cl-return (cons rule path)))))

      (puthash rule t finished)
      (push rule (oref analysis-data linear-extension))
      (cl-return nil))))

(cl-defun phony--try-linear-extension (analysis-data grammar)
  "Try to construct the linear extension of GRAMMAR's dependency graph.

This function assumes that `phony--analysis-data-productions' has been
populated in ANALYSIS-DATA.

If it is not possible to create a linear extension because of a cycle,
`phony--analysis-data-cycle' of ANALYSIS-DATA is set to that cycle and
`phony--analysis-data-contains-errors' is set to t.  Otherwise,
`phony--analysis-data-linear-extension' is populated with a valid linear
extension."
  (let ((visited (make-hash-table))
        (finished (make-hash-table)))
    (seq-doseq (rule (phony--get-rules grammar))
      (when-let* ((cycle (phony--try-linear-extension-impl
                          rule visited finished
                          analysis-data)))
        (oset analysis-data cycle (seq-map #'phony--rule-name cycle))
        (cl-return-from phony--try-linear-extension)))))

(defvar phony--last-analysis nil
  "Results of the last performed analysis.")

(defun phony--analyze-grammar (grammar)
  "Analyze GRAMMAR.

This returns a `phony--analysis-data' structure populated with the
results of the analysis."
  ;; TODO: Make this side-effect free and move definition to
  ;; phony--grammar-analysis.
  (let ((analysis-data (phony--make-analysis-data)))
    (phony--populate-dependency-graph analysis-data grammar)
    (phony--try-linear-extension analysis-data grammar)
    (setf (phony--analysis-data-linear-extension analysis-data)
          (reverse
           (phony--analysis-data-linear-extension analysis-data)))
    (when-let* ((cycle (phony--analysis-data-cycle analysis-data)))
      (display-warning 'phony (concat "Cycle found: "
                                      (string-join
                                       (seq-map #'symbol-name cycle)
                                       " -> ")))
      (setf (phony--analysis-data-contains-errors analysis-data) t))
    (setq phony--last-analysis analysis-data)
    (setf (phony--analysis-data-grammar analysis-data) grammar)
    analysis-data))

(phony--define-grammar-attribute phony--grammar-analysis (grammar)
  "Return the analysis data for GRAMMAR."
  (phony--analyze-grammar grammar))

(defcustom phony-export-function 'phony-talon-export
  "Function to be used for exporting spoken rules."
  ;; Using radio instead of choice did not display :tag
  :type '(choice (function-item :tag "Dragonfly exporter"
                                phony-dragonfly-export)
                 (function-item :tag "Talon exporter"
                                phony-talon-export))
  :tag "Phony Rule Exporter"
  :risky t
  :group 'phony)

(defun phony--export-all ()
  "Export all rules to the speech recognition engine.

If any errors are detected in the grammar, the rules are not exported.

If no rules are defined, this function does nothing."
  (when (phony--get-rules phony--default-grammar)
    (let* ((prepared-grammar (phony--prepare-grammar phony--default-grammar))
           (analysis-data (phony--analyze-grammar prepared-grammar))
           (phony--default-grammar prepared-grammar))
      (if (phony--analysis-data-contains-errors analysis-data)
          (display-warning 'phony "Grammar contains errors, not exporting")
        (phony--export-dictionaries)
        (when (and (not noninteractive)
                   (not (server-running-p))
                   (y-or-n-p "Emacs needs to run as a daemon for phony to work.  Start daemon?"))
          (server-start))
        (cancel-function-timers #'phony--sync-state)
        (run-with-idle-timer 0.1 t #'phony--sync-state)
        (funcall phony-export-function analysis-data)
        (setq phony--exported-grammar prepared-grammar)))))

(defun phony--debounce (f)
  "Debounce the invocation of F by waiting until next idle.

Multiple invocations to F will collapse into one invocation upon idle
timer activation."
  (cancel-function-timers f)
  (run-with-idle-timer 0.0 nil f))

(defun phony-request-export ()
  "Export all rules when next idle.

If `phony-mode' is not enabled, this function does nothing."
  (interactive)
  (when phony-mode
    (if phony--debounce-export-requests
        (phony--debounce #'phony--export-all)
      (phony--export-all))))

(defun phony--define-procedure-rule (arguments)
  "Define a procedure rule from ARGUMENTS.

See `phony-defun' for more information."
  (if (plist-member arguments :interactive)
      (progn (setf (plist-get arguments :interactive-p)
                   (plist-get arguments :interactive))
             (cl-remf arguments :interactive))
    (setf (plist-get arguments :interactive-p)
          (and (not (map-contains-key arguments :contributes-to))
               (not (map-contains-key arguments :provides)))))
  (when (plist-member arguments :anchor-beginning)
    (setf (plist-get arguments :anchor-beginning-p)
          (plist-get arguments :anchor-beginning))
    (cl-remf arguments :anchor-beginning))
  (when (plist-member arguments :anchor-end)
    (setf (plist-get arguments :anchor-end-p)
          (plist-get arguments :anchor-end))
    (cl-remf arguments :anchor-end))
  (phony--add-new-rule #'phony--make-procedure-rule arguments)
  (phony-request-export)
  (plist-get arguments :name))

(defmacro phony-defun (name pattern &rest rest)
  ;; checkdoc-params: (rest)
  "Define a procedure rule invokeable by voice.

NAME is the unquoted name of the rule.

When PATTERN is matched, BODY is evaluated.  This can be done to perform
actions through side effects, or to provide values for other rules.  The
value of matching the procedure rule is the value returned by BODY.

PATTERN is either a string literal, in which case the rule is matched
when that string is uttered, or it is an unquoted list of elements.  In
that case the rule is matched when each element is uttered in sequence.
An element can take the following forms:

  STRING           Match a literal STRING.
  RULE             Match a rule named RULE.
  (ARG RULE)       Match RULE, bind its value to argument ARG when
                   evaluating BODY.
  (seq ELEMS...)   Match elements ELEMS in sequence.
  (? ELEMS...)     Optionally match elements ELEMS.
  (* ELEMS...)     Match elements ELEMS zero or more times.
  (+ ELEMS...)     Match elements ELEMS one or more times.

Optional argument DOCSTRING is a documentation string for the rule.

Optional keyword arguments are provided as an alternating sequence of
KEY and VALUE.

Optional keywords unique to procedure rules are:

  :interactive       If nil, this rule cannot be spoken directly but may
                     occur as part of other rules.  Default is t unless
                     `:contributes-to' or `:provides' is non-nil, in
                     which case the default is nil.
  :anchor-beginning  If t, this rule must occur first in an utterance.
                     Default is nil.
  :anchor-end        If t, this rule must occur last in an utterance.
                     Default is nil.

Optional keywords common to all rule types are:

  :mode              An unquoted mode or list of modes for which this
                     rule should be active.  If none of the modes match,
                     this rule can't match.  As a special case, `global'
                     always matches.  Default is `global'.
  :contributes-to    An unquoted symbol or list of symbols of open
                     rules that this procedure should contribute to.
                     See `phony-define-open-rule' for open rules.
                     Default is nil.
  :provides          An unquoted symbol of an interface rule that this
                     rule is a provider of.  See
                     `phony-define-interface' for interface rules.
                     Default is nil.
  :module            An unquoted symbol naming the module that this rule
                     is part of.  See `phony-define-module' and
                     `phony-module' for information on modules.  Default
                     is nil.

\(fn NAME PATTERN [DOCSTRING] [KEY VALUE]... BODY...)"
  (declare (indent 2)
           (doc-string 3)
           (debug (&define
                   name
                   [&or stringp sexp]
                   [&rest keywordp sexp]
                   def-body)))
  ;; Syntactical design decisions:
  ;; - Automatic argument deduction: Explicitly specifying the
  ;;   argument list meant that adding a parameter necessitated a
  ;;   change in two places.  Things like optional arguments were not
  ;;   semantically relevant in the argument list, as they would
  ;;   always be populated with nil anyway.
  ;; - Optional parameters after docstring: The doc-string declare
  ;;   form only allows a constant, so comment syntax highlighting
  ;;   would not be possible the other way around.
  ;; - Elision of parentheses when pattern is just a literal: Allows the
  ;;   following nice looking syntax:
  ;;   (phony-defun chuck-line "chuck line"
  ;;     (kill-line))
  ;; - Pattern after name, before doc-string:
  ;;   - I want the pattern to be indented specially, but not the
  ;;     docstring.  The indent declare form allows this if
  ;;     pattern is before documentation.
  ;;   - If it was the other way around and documentation was omitted,
  ;;     the elision of parentheses for string literals could trick
  ;;     the syntax highlighting to treat it as documentation.
  ;; - Implicit argument naming: This allows the following terse
  ;;   syntax for simple rules:
  ;;   (phony-defun chuck-thing ("chuck" thing)
  ;;     (kill-thing thing))
  ;; - Name phony-defun: Chosen because of the similarity with defun.
  ;;   However, this could potentially give the impression that we are
  ;;   defining a function, something that may not be true in the future.
  ;; - Implicit seq for sequence of elements: In practice, this is the
  ;;   most common construction to use at the top level (perhaps
  ;;   excepts a single string literal, which is also covered by
  ;;   shorthand).  Might as well allow eliding it.
  ;; - Unquoted :contributes-to: By restricting the legal forms that
  ;;   may be passed to it, we can better utilize capf and xref.  For
  ;;   example, we know that function names cannot appear in the form,
  ;;   so those may be filtered out from completion and
  ;;   go-to-definition.
  ;; - Default :interactive nil on :contributes-to/:provides non-nil:
  ;;   In the common case, interactive rules are top-level.  Rarely
  ;;   are they also used as building blocks for other rules as well.
  ;;   A common mistake was therefore to forget to set :interactive to
  ;;   nil, causing erroneous behaviour.

  ;; TODO: Move more of the logic to phony--define-procedure-rule:
  ;; - Implicit argument deduction
  ;; - Adding implicit 'seq (if not already done)
  ;; - Sanity checks
  ;; - Consider removing implicit argument naming.  In the presence of
  ;;   namespaces, the default argument name is too clunky anyway.
  (let* ((doc (and (stringp (car rest)) (pop rest)))
         (split-arguments (phony--split-keywords-rest rest))
         (optional-arguments (car split-arguments))
         (body (cdr split-arguments))
         (expanded-pattern
          (phony--expand-implicit-arguments
           (cons 'seq (ensure-list pattern))))
         (arguments (phony--collect-arguments expanded-pattern))
         (unused-arguments
          (seq-remove (lambda (argument)
                        (or (string-prefix-p "_" (symbol-name argument))
                            (memq argument (flatten-tree body))))
                      arguments)))

    (cond
     (unused-arguments
      `(display-warning
        'phony
        ,(concat
          (format "Unused arguments in %s: %s\n"
                  name
                  (mapconcat #'symbol-name unused-arguments ", "))
          "Either use it in the body or prefix the argument with \"_\" (underscore)")))
     ((not (equal (seq-uniq arguments) arguments))
      ;; TODO: Do not emit this warning if duplication is implicit and
      ;; not used in body.
      `(display-warning
        'phony
        ,(concat
          (format "Duplicate arguments in %s\n" name)
          "If you use implicit argument names, make them explicit")))
     (t `(phony--define-procedure-rule
          (append
           (list :name ',name
                 :function (lambda ,arguments ,@(ensure-list doc) ,@body)
                 :arglist ',arguments
                 :element ,(phony--parse-speech-element expanded-pattern arguments)
                 :documentation ,doc)
           ',optional-arguments))))))

(phony-define-dictionary phony--impossible
  "Rule that always fails to match."
  '())

(eval-and-compile
  (defun phony--expand-implicit-arguments (element-form)
    "Expand implicit arguments in ELEMENT-FORM.

A bare symbol `foo' is expanded to `(foo foo)', binding the rule's
match value to an argument of the same name.  Recurses into `seq',
`?', `+', `*' forms."
    (cond
     ((and (listp element-form) (memq (car element-form) '(seq ? + *)))
      `(,(car element-form)
        ,@(seq-map #'phony--expand-implicit-arguments (cdr element-form))))
     ((symbolp element-form)
      `(,element-form ,element-form))
     (t element-form)))

  (defun phony--collect-arguments (element-form)
    "Collect argument names from ELEMENT-FORM.
Return a list of symbols, one per argument binding found in the
element tree."
    (cond
     ((and (listp element-form) (memq (car element-form) '(seq ? + *)))
      (seq-mapcat #'phony--collect-arguments (cdr element-form)))
     ((listp element-form)
      (list (car element-form)))
     (t '()))))

(phony-define-dictionary phony-module
  "Dictionary of defined modules.
Whenever a module is defined with `phony-module', it is added to this
dictionary."
  '())

(defun phony--sync-state ()
  "Export information about which rules are currently active."
  ;; We must filter the enabled rules before doing with-temp-file, as
  ;; that may otherwise influence which rules are enabled.
  (let ((active-rules (seq-filter #'phony--rule-active-p
                                  (phony--get-rules phony--exported-grammar))))
    (with-temp-file (phony--output-directory "active-rules")
      (insert (string-join
               (seq-map #'phony--rule-external-name
                        (seq-remove
                         (lambda (rule)
                           (phony--rule-always-active-p
                            rule phony--exported-grammar))
                         active-rules))
               "\n")
              "\n"))))

(defun phony--evaluate-ast (ast)
  "Evaluate AST constructed from an utterance.

Evaluation is done with reference to `phony--exported-grammar'."
  (if (atom ast)
      ast
    (let* ((type (car ast))
           (arguments (cdr ast))
           (rule (phony--get-rule type phony--exported-grammar)))
      (cond
       ((eq type 'list)
        (seq-map #'phony--evaluate-ast
                 arguments))
       ((phony--dictionary-p rule)
        (phony-dictionary-get (car arguments) type))
       ((phony--procedure-rule-p rule)
        (apply (phony--procedure-rule-function rule)
               (seq-map #'phony--evaluate-ast
                        arguments)))
       ((phony--open-rule-p rule)
        (phony--evaluate-ast (cadr ast)))
       (t (error "Failed to evaluate AST: %S" ast))))))

(provide 'phony-core)
